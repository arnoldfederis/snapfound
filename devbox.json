{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": [
    "process-compose@latest",
    "traefik@latest",
    "hostctl@latest",
    "yq@latest",
    "sops@latest",
    "age@latest",
    "mkcert@latest",
    "fzf@latest",
    "turbo@latest",
    "bun@latest",
    "direnv@latest",
    "watch@latest",
    "python@latest"
  ],
  "shell": {
    "init_hook": [
      "if [ ! -d \".venv\" ]; then python -m venv .venv; fi",
      "source .venv/bin/activate"
    ]
  }
}
